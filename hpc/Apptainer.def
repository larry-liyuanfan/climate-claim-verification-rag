Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends python3 python3-pip git ca-certificates
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir --upgrade pip
    python3 -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu124

%files
    . /opt/climate-rag

%post
    python3 -m pip install --no-cache-dir "/opt/climate-rag[dense,ltr,yaml,serve]"

%environment
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false

%runscript
    exec climate-rag "$@"

